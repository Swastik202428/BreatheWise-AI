# BreatheWise AI - Environment Variables (Phase 2 Upgrade)
# NEVER commit your actual .env file with secrets to Git!

# Google Gemini API Key (Server-side ONLY)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Real-Time Air Quality & Weather API
# Open-Meteo CAMS Real-Time Telemetry runs by default with NO API key required.
# Optional: World Air Quality Index token (https://aqicn.org/api/)
WAQI_API_KEY=your_waqi_token_optional

# Optional Frontend Override (leave empty in local dev to use Vite proxy /api)
# VITE_API_URL=http://localhost:3001

# Optional Firebase Configuration (for cloud sync)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
